# Django Secret Key (Render can auto-generate or set a strong random secret)
SECRET_KEY=your-secret-key-here

# Set to True for local development, False for production
DEBUG=False

# Comma-separated list of allowed hostnames (Render sets RENDER_EXTERNAL_HOSTNAME automatically)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Optional PostgreSQL Database URL (if using Render Postgres)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
